{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "group_status",
    "task_results",
    "files_changed",
    "verification",
    "concerns",
    "coordination",
    "time_management"
  ],
  "properties": {
    "result": {
      "type": "string",
      "minLength": 1
    },
    "group_status": {
      "type": "string",
      "enum": [
        "DONE",
        "DONE_WITH_CONCERNS",
        "NEEDS_CONTEXT",
        "NEEDS_COORDINATION",
        "BLOCKED"
      ]
    },
    "task_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "status",
          "evidence"
        ],
        "properties": {
          "task": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "SATISFIED",
              "UNSATISFIED",
              "BLOCKED"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "concerns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coordination": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "time_management": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "timebox",
        "checkpoints",
        "timeout_action"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ON_TRACK",
            "CHECKPOINT",
            "TIMEBOX_EXPIRED",
            "N/A"
          ]
        },
        "timebox": {
          "type": "string",
          "minLength": 1
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_action": {
          "type": "string",
          "enum": [
            "完成验收",
            "带证据重排",
            "升级阻塞",
            "N/A"
          ]
        }
      }
    }
  }
}
